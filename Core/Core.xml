<Ui xmlns="http://www.blizzard.com/wow/ui/">
    <!-- Addon.lua first: it makes the addon object every other file adds to. -->
    <Script file="Addon.lua"/>
    <Script file="Place.lua"/>
    <Script file="Log.lua"/>
    <Script file="Detect.lua"/>
    <!-- Text.lua before Window.lua: each window takes its text settings at creation. -->
    <Script file="Text.lua"/>
    <Script file="Window.lua"/>
    <Script file="CatchWindow.lua"/>
    <Script file="Tooltip.lua"/>
    <Script file="Commands.lua"/>
    <Script file="Options.lua"/>
    <!-- Development only, last: it hooks the methods above. One @debug block, empty in a release. -->
    <Script file="Dev.lua"/>
</Ui>
